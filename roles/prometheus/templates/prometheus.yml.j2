global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    replica: '{{ inventory_hostname }}'

alerting:
  alertmanagers:
    - static_configs:
        - targets:
{% for host in groups[prometheus_group] | default([]) %}
          - '{{ hostvars[host].ansible_host | default(host) }}:{{ prometheus_alertmanager_port }}'
{% endfor %}

rule_files:
  - '{{ prometheus_rules_dir }}/*.yml'

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets:
{% for host in groups[prometheus_group] | default([]) %}
        - '{{ hostvars[host].ansible_host | default(host) }}:{{ prometheus_port }}'
{% endfor %}

  - job_name: 'alertmanager'
    static_configs:
      - targets:
{% for host in groups[prometheus_group] | default([]) %}
        - '{{ hostvars[host].ansible_host | default(host) }}:{{ prometheus_alertmanager_port }}'
{% endfor %}

{% for scrape_config in prometheus_scrape_configs | default([]) %}
  - {{ scrape_config | to_nice_yaml(indent=2) | indent(4) }}
{% endfor %}
