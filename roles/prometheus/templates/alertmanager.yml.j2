#jinja2: lstrip_blocks: True
global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'telegram'

receivers:
  - name: 'telegram'
    telegram_configs:
      - bot_token: '{{ telegram_bot_token }}'
        chat_id: {{ telegram_chat_id }}
        parse_mode: 'HTML'
        message: {% raw %}'{{ template "telegram.default.message" . }}'{% endraw %}

templates:
  - '{{ prometheus_alertmanager_config_dir }}/templates/*.tmpl'

inhibit_rules:
  # A down host floods Telegram with symptom alerts (high CPU, low disk,
  # exporter down...). Suppress its warning-level alerts while the critical
  # InstanceDown alert fires for the same instance.
  - source_matchers:
      - 'alertname = InstanceDown'
    target_matchers:
      - 'severity = warning'
    equal: ['instance']