# Managed by Ansible - environment for the netbox and netbox-worker
# containers. Consumed by the netbox-docker configuration.py mounted
# at /etc/netbox/config (see configuration/ in the compose project).
ALLOWED_HOSTS={{ netbox_allowed_hosts | join(' ') }}
CSRF_TRUSTED_ORIGINS={{ netbox_csrf_trusted_origins | join(' ') }}
SECRET_KEY={{ netbox_secret_key }}
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD={{ netbox_postgres_password }}
REDIS_HOST=redis
REDIS_PASSWORD={{ netbox_redis_password }}
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PASSWORD={{ netbox_redis_password }}
# The mounted configuration.py derives MEDIA_ROOT from its own path;
# point it back at the bind-mounted media directory in the image.
MEDIA_ROOT=/opt/netbox/netbox/media
# Initial superuser, created by the entrypoint when missing.
SUPERUSER_NAME={{ netbox_superuser_name }}
SUPERUSER_EMAIL={{ netbox_superuser_email }}
SUPERUSER_PASSWORD={{ netbox_superuser_password }}
SKIP_SUPERUSER=false
RELEASE_CHECK_URL=https://api.github.com/repos/netbox-community/netbox/releases
