# Managed by Ansible - environment for the Open WebUI container
OPENAI_API_BASE_URL={{ openwebui_openai_base_url }}
OPENAI_API_KEY={{ openwebui_openai_api_key }}
WEBUI_AUTH=True
ENABLE_SIGNUP={{ 'true' if openwebui_enable_signup else 'false' }}
{% for key, value in openwebui_env.items() %}
{{ key }}={{ value }}
{% endfor %}
