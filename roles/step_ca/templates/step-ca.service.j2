[Unit]
Description=step-ca
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ step_ca_server_user }}
Group={{ step_ca_server_group }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/step-ca {{ step_ca_install_path }}/config/ca.json --password-file {{ step_ca_install_path }}/.password
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
