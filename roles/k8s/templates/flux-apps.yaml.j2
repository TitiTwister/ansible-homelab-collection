---
# Root applications kustomization for the Flux fleet repository, rendered by
# the k8s role and seeded once into {{ k8s_flux_sync_path }}/apps.yaml.
# It reconciles every application under {{ k8s_flux_apps_path }}/ against
# the cluster state.
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: apps
  namespace: {{ k8s_flux_namespace }}
spec:
  interval: {{ k8s_flux_apps_interval }}
  path: ./{{ k8s_flux_apps_path }}
  prune: true
  sourceRef:
    kind: GitRepository
    name: {{ k8s_flux_namespace }}
