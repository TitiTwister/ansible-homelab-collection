---
# Forgejo Secrets, rendered by the k8s role from inventory variables.
# Values are base64-encoded (data, not stringData): kubectl apply sends a
# phantom patch for stringData manifests on every run, which would
# spuriously report changes and trigger the restart handler.
apiVersion: v1
kind: Secret
metadata:
  name: forgejo-db-secret
  namespace: {{ k8s_forgejo_namespace }}
type: Opaque
data:
  password: {{ k8s_forgejo_db_password | b64encode | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: forgejo-admin-secret
  namespace: {{ k8s_forgejo_namespace }}
type: Opaque
data:
  username: {{ k8s_forgejo_admin_username | b64encode | to_json }}
  password: {{ k8s_forgejo_admin_password | b64encode | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: forgejo-ca-bundle
  namespace: {{ k8s_forgejo_namespace }}
type: Opaque
data:
  ca.crt: {{ k8s_forgejo_ca_bundle | b64encode | to_json }}
