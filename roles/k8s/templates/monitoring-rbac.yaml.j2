---
# Monitoring RBAC for the site Prometheus, rendered by the k8s role from
# inventory variables. Read-only: service discovery and metrics
# endpoints. The Secret holds a long-lived token; the token and the
# cluster CA are fetched to files/k8s/monitoring/ on the control node.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ k8s_monitoring_namespace }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ k8s_monitoring_serviceaccount }}
  namespace: {{ k8s_monitoring_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ k8s_monitoring_serviceaccount }}
rules:
  # Service discovery (kubernetes_sd_configs)
  - apiGroups: [""]
    resources: [nodes, services, endpoints, pods]
    verbs: [get, list, watch]
  # kubelet and cAdvisor metrics endpoints
  - apiGroups: [""]
    resources: [nodes/metrics, nodes/metrics/cadvisor]
    verbs: [get]
  # API server service proxy: in-cluster metrics services (kube-state-metrics,
  # longhorn-backend) reached through the masters, no direct node path needed
  - apiGroups: [""]
    resources: [services/proxy]
    verbs: [get]
  # API server metrics endpoints
  - nonResourceURLs: [/metrics, /metrics/cadvisor]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ k8s_monitoring_serviceaccount }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ k8s_monitoring_serviceaccount }}
subjects:
  - kind: ServiceAccount
    name: {{ k8s_monitoring_serviceaccount }}
    namespace: {{ k8s_monitoring_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ k8s_monitoring_serviceaccount }}-token
  namespace: {{ k8s_monitoring_namespace }}
  annotations:
    kubernetes.io/service-account.name: {{ k8s_monitoring_serviceaccount }}
type: kubernetes.io/service-account-token
