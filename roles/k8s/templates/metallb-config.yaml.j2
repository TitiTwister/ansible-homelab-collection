---
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: {{ k8s_metallb_pool_name }}
  namespace: metallb-system
spec:
  addresses:
    - {{ k8s_metallb_pool_range }}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: {{ k8s_metallb_pool_name }}-l2
  namespace: metallb-system
spec:
  ipAddressPools:
    - {{ k8s_metallb_pool_name }}
  interfaces:
    - "{{ k8s_node_interface.stdout }}"
