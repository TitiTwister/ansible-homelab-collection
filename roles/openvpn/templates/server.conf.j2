# OpenVPN Server Configuration
# Generated by Ansible

# Network configuration
port {{ openvpn_port }}
proto {{ openvpn_protocol }}
dev {{ openvpn_dev }}

# VPN subnet
server {{ openvpn_subnet }} {{ openvpn_netmask }}

# Certificate paths
ca {{ openvpn_cert_dir }}/ca.crt
cert {{ openvpn_cert_dir }}/openvpn-server.crt
key {{ openvpn_cert_dir }}/openvpn-server.key
dh /etc/openvpn/dh.pem
tls-auth /etc/openvpn/ta.key 0

# Cryptography settings
cipher {{ openvpn_cipher }}
tls-version-min {{ openvpn_tls_version_min }}
tls-server

# Keepalive
keepalive {{ openvpn_keepalive }}

# Compression (disable if not supported by all clients)
;compress lz4-v2
;push "compress lz4-v2"

# Logging
status /var/log/openvpn/openvpn-status.log
verb 3

# Client configuration directory
client-config-dir /etc/openvpn/ccd
ccd-exclusive

# Push DNS and routes to clients
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
push "redirect-gateway def1 bypass-dhcp"

# Security settings
user nobody
group nobody
persist-key
persist-tun

# Max clients
max-clients 10

# Management interface (optional)
;management localhost 7505
