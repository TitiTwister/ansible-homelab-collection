# WireGuard client configuration for {{ item['item'] }}
# Generated by Ansible

{% set peer = __wireguard_peers | selectattr('name', 'equalto', item['item']) | first %}
[Interface]
PrivateKey = {{ item['content'] | b64decode | trim }}
Address = {{ peer['ip'] }}/24
{% if wireguard_dns %}
DNS = {{ wireguard_dns | join(', ') }}
{% endif %}
{% if wireguard_mtu %}
MTU = {{ wireguard_mtu }}
{% endif %}

[Peer]
PublicKey = {{ __wireguard_server_pubkey['stdout'] | trim }}
Endpoint = {{ wireguard_server_public_ip }}:{{ wireguard_port }}
AllowedIPs = {{ wireguard_client_allowed_ips | join(', ') }}
PersistentKeepalive = {{ wireguard_persistent_keepalive }}
