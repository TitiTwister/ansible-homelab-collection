# WireGuard server configuration for {{ wireguard_interface }}
# Generated by Ansible

[Interface]
Address = {{ wireguard_server_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ __wireguard_server_key['content'] | b64decode | trim }}

# NAT and forwarding are delegated to firewalld (masquerade on the
# zone bound to the VPN subnet): no PostUp/PostDown rules here.
{% for peer in __wireguard_peers %}

[Peer]
# {{ peer['name'] }}
PublicKey = {{ peer['public_key'] }}
AllowedIPs = {{ peer['ip'] }}/32
{% endfor %}
